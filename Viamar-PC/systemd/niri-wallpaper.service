[Unit]
Description=Wallpaper multi-monitor (azote/swaybg)
PartOf=graphical-session.target
Requisite=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh %h/.azotebg
ExecStop=/usr/bin/pkill -u %u swaybg

[Install]
WantedBy=graphical-session.target
