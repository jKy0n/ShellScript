[Unit]
Description=KDE Connect Indicator
# Corrigido: original referenciava "kdeconnectd.service" sem prefixo,
# não batendo com o arquivo real (jkyon-kdeconnectd.service).
After=graphical-session.target niri-kdeconnectd.service
Requisite=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/kdeconnect-indicator
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
