[Unit]
Description=OpenRGB
# PENDENTE: dependia de jkyon-snixembed.service, que não veio na sua lista.
# Se não for recriar esse serviço, apaga "niri-snixembed.service" da linha
# abaixo ou o daemon-reload vai reclamar de dependência inexistente.
After=graphical-session.target niri-snixembed.service
Requisite=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/openrgb --startminimized
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
