{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "multithreading": true,

    "logo": {
        "type": "chafa",
        "source": "/home/jkyon/Pictures/ArchLinux-medias/crisnote-proto-logo.png",
        "width":  40,
        "height": 20,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "    ",
        "color": "white"
    },

    "modules": [
        {
            "type": "custom",
            "format": "─────────────────────────────── \u001b[1m Software \u001b[0m ──────────────────────────────",
            "key": " "
        },
        {
            "type": "os",
            "key": " ",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": " ",
            "format": "{1} {2}"
        },
        {
            "type": "command",  // Package Manager version (pacman + paru)
            "key": " ",
            "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-packageManager-version.sh",
            "format": "{1}"
        },
        {
            "type": "command",
            "key": " ",
            "text": "sh /home/jkyon/ShellScript/fastfetchCustomTerminal.sh",
            "format": "{1} "
        },
        {
            "type": "editor",
            "key": " ",
            "format": "{2} {5}"
        },
        {
            "type": "command",  // Btrfs + Bees version
            "key": " ",
            "text": "sh /home/jkyon/ShellScript/fastfetch-scripts/fastfetch-btrfs+bees-version.sh",
            "format": "{1} "
        },
        {
            "type": "initsystem",
            "key": " ",
            "format": "{1} - {3} "
        },
        {
            "type": "command",
            "key": " 󱕵",
            "text": " sudo --version | awk 'NR==1 {print $1, $3 }' ",
            "format": "{1} "
        },
        {
            "type": "command",
            "key": " 󱫠",
            "text": " sh -c 'grub-install --version | awk \"{print \\$2, \\$3}\" | awk \"{gsub(/\\(|\\)/,\\\"\\\"); print \\$1, \\$2}\"' ",
            "format": "{1} + GRUB BtrFS"
        },
        {
            "type": "custom",
            "format": "─────────────────────────────── \u001b[1m Hardware \u001b[0m ──────────────────────────────",
            "key": " "
        },
        {
            "type": "cpu",
            "key": " ",
            "showPeCoreCount": true,
            "temp": true,
            "format": "{1} ({5}) - {7} - {8}"
        },
        {
            "type": "memory",
            "key": " ",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "gpu",
            "detectionMethod": "pci",
            "key": " 󰢮",
            "format": "{1} {2}"
        },
        {
            "type": "command",
            "key": " 󰚗",
            "text": "sh /home/jkyon/ShellScript/Viamar-PC/fastfetch/fastfetch-MoBo-info.sh",
            "format": "{1} "
        },
        {
            "type": "disk",
            "key": " ",
            "percent": {},
            "format": "{10} - {1} / {2} - ({3}) - {9}"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────── \u001b[1m Uptime \u001b[0m ───────────────────────────────",
            "key": " "
        },
        {
            "type": "command",
            "key": " ",
            "text": "whoami",
            "format": "{1} "
        },
        {
            "type": "command",
            "key": " 󰪫",
            "text": "uname -n",
            "format": "{1} "
        },
        {
            "type": "packages",
            "key": " ",
            "format": "{31} Packages"
        },
        {
            "type": "uptime",
            "key": " "
        },
        {
            "type": "localip",
            "key": " 󰌗",
            "format": "{1} "
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
    ]
}